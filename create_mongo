/**
 * init_studflow_db.js
 * Скрипт создания базы данных MongoDB для Studflow-бота (MAX/Telegram).
 *
 * Запуск:
 *   mongosh "mongodb://localhost:27017" init_studflow_db.js
 * или, если нужна конкретная БД/хост:
 *   mongosh "mongodb://user:pass@host:27017/studflow" init_studflow_db.js
 *
 * Скрипт идемпотентен: коллекции с валидацией пересоздаются (drop+create),
 * индексы создаются через createIndexes (createIndex с игнорированием,
 * если уже существуют).
 */

const dbName = "studflow";
db = db.getSiblingDB(dbName);

print(`\n=== Инициализация базы "${dbName}" ===\n`);

// 1. universities — справочник вузов
db.universities.drop();
db.createCollection("universities", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["short_name", "full_name", "is_active"],
      properties: {
        short_name: { bsonType: "string", description: "Короткое название, напр. ИТМО" },
        full_name: { bsonType: "string" },
        aliases: {
          bsonType: "array",
          items: { bsonType: "string" },
          description: "Варианты написания в нижнем регистре для поиска"
        },
        departments: {
          bsonType: "array",
          items: { bsonType: "string" }
        },
        is_active: { bsonType: "bool" },
        created_at: { bsonType: "date" }
      }
    }
  },
  validationLevel: "moderate",
  validationAction: "error"
});

db.universities.createIndex({ short_name: 1 }, { unique: true, name: "uniq_short_name" });
db.universities.createIndex({ aliases: 1 }, { name: "idx_aliases" });

// 2. users — студенты и сотрудники (единая коллекция с дискриминатором role)
db.users.drop();
db.createCollection("users", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["chat_id", "user_id", "role", "university"],
      properties: {
        chat_id: { bsonType: "long" },
        user_id: { bsonType: "long" },
        role: { enum: ["student", "staff"] },
        last_name: { bsonType: "string" },
        first_name: { bsonType: "string" },
        patronymic: { bsonType: ["string", "null"] },
        university: { bsonType: "string" },
        student_profile: {
          bsonType: ["object", "null"],
          properties: {
            group: { bsonType: "string" },
            direction: { bsonType: "string" },
            admission_year: { bsonType: ["int", "long"] },
            graduation_year: { bsonType: ["int", "long"] },
            student_number: { bsonType: "string" }
          }
        },
        staff_profile: {
          bsonType: ["object", "null"],
          properties: {
            department: { bsonType: "string" },
            position: { bsonType: "string" }
          }
        },
        created_at: { bsonType: "date" },
        updated_at: { bsonType: "date" }
      }
    }
  },
  validationLevel: "moderate",
  validationAction: "error"
});

db.users.createIndex({ chat_id: 1 }, { unique: true, name: "uniq_chat_id" });
db.users.createIndex({ user_id: 1 }, { name: "idx_user_id" });
db.users.createIndex(
  { role: 1, university: 1, "staff_profile.department": 1 },
  { name: "idx_staff_department" }
);
db.users.createIndex({ role: 1, university: 1 }, { name: "idx_role_university" });

print("✔ users создана");

// 3. counters — генератор коротких числовых id для обращений
db.counters.drop();
db.createCollection("counters");
db.counters.insertOne({ _id: "query_id", seq: 1000 });

print("✔ counters создана (стартовый seq=1000)");

// 4. queries — обращения студентов к кафедрам
db.queries.drop();
db.createCollection("queries", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["query_id", "student", "department", "question", "status"],
      properties: {
        query_id: { bsonType: ["int", "long"] },
        student: {
          bsonType: "object",
          required: ["user_id", "chat_id"],
          properties: {
            user_id: { bsonType: "long" },
            chat_id: { bsonType: "long" },
            full_name: { bsonType: "string" },
            university: { bsonType: "string" }
          }
        },
        department: { bsonType: "string" },
        question: { bsonType: "string" },
        status: { enum: ["pending", "answered", "cancelled"] },
        answer: {
          bsonType: ["object", "null"],
          properties: {
            text: { bsonType: ["string", "null"] },
            answered_by: { bsonType: ["long", "null"] },
            answered_by_name: { bsonType: ["string", "null"] },
            answered_at: { bsonType: ["date", "null"] }
          }
        },
        created_at: { bsonType: "date" },
        updated_at: { bsonType: "date" }
      }
    }
  },
  validationLevel: "moderate",
  validationAction: "error"
});

db.queries.createIndex({ query_id: 1 }, { unique: true, name: "uniq_query_id" });
db.queries.createIndex(
  { "student.university": 1, department: 1, status: 1 },
  { name: "idx_department_inbox" }
);
db.queries.createIndex(
  { "student.user_id": 1, status: 1 },
  { name: "idx_my_answers" }
);

print("✔ queries создана");

// 5. dialog_states — состояние FSM-диалога по каждому чату
db.dialog_states.drop();
db.createCollection("dialog_states", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["chat_id", "state", "updated_at"],
      properties: {
        chat_id: { bsonType: "long" },
        user_id: { bsonType: ["long", "null"] },
        state: {
          enum: [
            "IDLE",
            "AWAITING_ROLE",
            "AWAITING_STUDENT_REGISTRATION",
            "AWAITING_STAFF_REGISTRATION",
            "AWAITING_DEPARTMENT",
            "AWAITING_QUERY_TEXT",
            "AWAITING_ANSWER_TEXT"
          ]
        },
        context: { bsonType: "object" },
        updated_at: { bsonType: "date" }
      }
    }
  },
  validationLevel: "moderate",
  validationAction: "error"
});

db.dialog_states.createIndex({ chat_id: 1 }, { unique: true, name: "uniq_chat_id" });
// TTL: автоочистка "зависших" диалогов через 24 часа неактивности
db.dialog_states.createIndex(
  { updated_at: 1 },
  { expireAfterSeconds: 86400, name: "ttl_updated_at" }
);

print("✔ dialog_states создана (TTL 24ч)");

// 6. event_log — лог событий диспетчера (message_created / message_callback)
db.event_log.drop();
db.createCollection("event_log", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["event_type", "chat_id", "created_at"],
      properties: {
        router_id: { bsonType: "string" },
        event_type: { enum: ["message_created", "message_callback"] },
        chat_id: { bsonType: "long" },
        user_id: { bsonType: ["long", "null"] },
        raw_payload: { bsonType: "object" },
        created_at: { bsonType: "date" }
      }
    }
  },
  validationLevel: "moderate",
  validationAction: "warn" // не блокируем запись логов даже при неполных данных
});
